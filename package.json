{
  "name": "e2e-playwright-demo",
  "version": "1.0.0",
  "description": "A test automation suite using Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke-tests": "playwright test tests/smoke",
    "test:ui-tests": "playwright test tests/ui",
    "test:chromium": "playwright test --project=chromium",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuksa-QA/e2e-playwright-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kuksa-QA/e2e-playwright-demo/issues"
  },
  "homepage": "https://github.com/kuksa-QA/e2e-playwright-demo#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.2.0"
  }
}
